# Linked to ~/.zshrc by link.sh. Put machine-specific or private settings
# (passwords, work paths, per-semester aliases...) in ~/.zshrc.local, which is
# never committed.

export DOTFILES="${${(%):-%x}:A:h:h}"   # repo root, resolved through the symlink

# --- oh-my-zsh --------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
[[ -f $ZSH/oh-my-zsh.sh ]] && source "$ZSH/oh-my-zsh.sh"

# --- environment --------------------------------------------------------------
export LANG=en_US.UTF-8
export EDITOR=nvim
typeset -U path   # no duplicate PATH entries
path=("$HOME/.local/bin" "$DOTFILES/bin" $path)

# --- aliases ----------------------------------------------------------------
alias zshconfig="nvim $DOTFILES/zsh/zshrc"
alias dots="cd $DOTFILES"
alias vi="nvim"
alias vim="nvim"
alias glog="git log --graph --oneline --decorate --all"
alias gsync="git fetch upstream && git rebase upstream/main && git push"

# --- tools (each is optional) -----------------------------------------------
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh

if [[ -d $HOME/.pyenv ]]; then
  export PYENV_ROOT="$HOME/.pyenv"
  path=("$PYENV_ROOT/bin" $path)
  (( $+commands[pyenv] )) && eval "$(pyenv init - zsh)"
fi

if [[ -d /usr/local/go/bin ]]; then
  path+=(/usr/local/go/bin)
fi
(( $+commands[go] )) && path+=("${GOPATH:-$HOME/go}/bin")

# --- light/dark theme by time of day (nvim + alacritty) ----------------------
# Cheap when nothing changed; see bin/theme-switch for settings.
(( $+commands[theme-switch] )) && theme-switch auto

# --- local overrides ----------------------------------------------------------
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
